{
  "name": "@deansasek/osrs-wiki-api",
  "version": "0.1.5",
  "description": "SDK, REST API wrapper, and MCP server for the Old School RuneScape Wiki",
  "author": "https://github.com/deansasek",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./sdk": "./dist/sdk/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "bun run server.ts",
    "mcp": "bun run mcp/server.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.7.0",
    "jimp": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
